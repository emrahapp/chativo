# ──────────────────────────────────────────────────────────────
# Chativo.ai — Environment variables
# Copy this file to .env.local and fill the values.
# NEVER commit .env.local.
# ──────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WIDGET_URL=http://localhost:3000/widget.js
NEXT_PUBLIC_DEFAULT_LOCALE=tr

# ── Supabase (https://supabase.com/dashboard) ────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Server only — has full DB access. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Redis (Upstash) for BullMQ ───────────────────────────────
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# ── Rate limit (Upstash REST, optional but recommended) ──────
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── Encryption (32-byte hex for BYOK in Faz 2 — generate now) ─
ENCRYPTION_KEY=

# ── Email (Resend recommended) ───────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@chativo.ai

# ── Admin allowlist (comma-separated emails) ─────────────────
ADMIN_EMAILS=you@chativo.ai

# ── Stripe ───────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
# Use sk_test_... in dev, sk_live_... in production.
STRIPE_SECRET_KEY=sk_test_...
# After creating a webhook endpoint, copy the signing secret.
# Local dev: install Stripe CLI and run `stripe listen --forward-to localhost:3000/api/billing/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create one product per plan, with monthly + yearly prices).
# Dashboard → Products → "Starter" → add Recurring price → copy price_xxx into here.
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_AGENCY_YEARLY=price_...

# ── iyzico (Faz 2 — TR pazar için, sonraki sprint) ───────────
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
